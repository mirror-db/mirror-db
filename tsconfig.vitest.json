// TSConfig for Node-environment tests (the e2e suite spawns wrangler and uses
// node:http). Separate from the worker config so Node globals are available.
{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "paths": {
      "@server/*": ["./server/*"]
    }
  },
  "include": ["server/**/*.e2e.test.ts", "vitest.e2e.config.ts"]
}
